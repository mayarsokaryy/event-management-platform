        <mxCell id="e5" value="&lt;font style=&quot;background-color: light-dark(rgb(255, 255, 255), rgb(0, 0, 0)); color: light-dark(rgb(0, 0, 0), rgb(204, 199, 199));&quot;&gt;Manage users and&lt;br&gt;platform settings&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" parent="1" source="admin" target="system" edge="1">
