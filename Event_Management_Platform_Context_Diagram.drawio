        <mxCell id="title" value="C4 Level 1 — System Context Diagram" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="280" y="35" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="system" value="&lt;font style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Event Management Platform&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allows attendees to discover events and book tickets;&lt;br&gt;allows organizers to create and manage events.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=16;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="390" y="270" width="390" height="170" as="geometry" />
        </mxCell>
        <mxCell id="attendee" value="&lt;span style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212));&quot;&gt;&lt;b style=&quot;&quot;&gt;Attendee&lt;/b&gt;&lt;br&gt;&lt;br&gt;Person&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Browses events and books tickets&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="150" width="220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="organizer" value="&lt;font style=&quot;color: rgb(9, 9, 9);&quot;&gt;&lt;b&gt;Organizer&lt;/b&gt;&lt;br&gt;&lt;br&gt;Person&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Creates and manages events&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="70" y="450" width="220" height="105" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;font style=&quot;background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); color: rgb(243, 243, 243);&quot;&gt;&lt;b style=&quot;&quot;&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Person&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Manages users and platform operations&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="850" y="150" width="250" height="105" as="geometry" />
